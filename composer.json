{
    "name": "waqas-badar/php-saga",
    "description": "A lightweight, framework-agnostic Saga orchestrator for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Waqas Badar",
            "email": "mwaqasbadar@yahoo.com",
            "role": "Lead Developer"
        },
        {
            "name": "Antigravity (Google DeepMind)",
            "role": "AI Pair Programmer"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/container": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "PhpSaga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSaga\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse src tests --level=max",
        "check": [
            "@test",
            "@stan"
        ]
    },
    "minimum-stability": "stable"
}
